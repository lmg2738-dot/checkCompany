{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "installCommand": "pip install -r requirements.txt",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/cron/daily-risk-email.py": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-risk-email",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron/daily-risk-email",
      "destination": "/api/cron/daily-risk-email"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
