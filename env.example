# 금융감독원 오픈다트 API 인증키 (40자). 이 파일을 복사해 .env 로 저장하세요.
# 예: copy env.example .env
DART_API_KEY=your_dart_api_key_here

# ========== Vercel 대시보드 → Settings → Environment Variables ==========
# Production·Preview·Development 모두 체크 후 Redeploy 필수.
#
# [필수] 분석
#   DART_API_KEY          Open DART 40자 키
#
# [필수] Supabase customers 테이블 사용 시 (둘 다 필요)
#   SUPABASE_URL          https://xxxx.supabase.co  (끝에 / 없음)
#   SUPABASE_KEY          anon JWT 또는 publishable 키 (sb_publishable_... 가능)
#     또는 SUPABASE_SERVICE_ROLE_KEY (서버 전용, RLS 우회)
#
# [선택]
#   DART_ANALYZE_SLEEP_SEC=0
#   ANALYZE_BULK_WORKERS=6
#   DART_RUNTIME_BIZ_SCAN_MAX=12000
#   DART_CORPCODE_IGNORE_CACHE=1
#
# [Cron] 매일 10:00 KST (vercel.json: 01:00 UTC)
#   CRON_SECRET=임의_긴_문자열   (Vercel Cron Authorization: Bearer ...)
#
# [Resend] 일일 위험 리포트 이메일 — /api/cron/daily-risk-email
#   RESEND_API_KEY=re_xxxxxxxx   ← Vercel 등록 시 이 이름으로 등록
#   RESEND_FROM=Report <onboarding@resend.dev>   (테스트 발신)
#   RESEND_TO=you@example.com    (수신: 이메일만, 한글 표시명 불가)
#
#   [Resend 테스트 모드 — 도메인 미인증 시]
#   onboarding@resend.dev 발신이면 수신은 Resend 가입 이메일만 가능 (403).
#   예: 가입이 lmg2738@gmail.com 이면 RESEND_TO=lmg2738@gmail.com 로 먼저 테스트.
#   cj.net 사용 시: resend.com/domains 에서 DNS 추가 후 상태가 Verified 여야 함.
#   RESEND_FROM=mplace@cj.net  RESEND_TO=lmg2738@cj.net
#   (Pending 이면 403 — DNS 전파·레코드 누락 확인)
#   DAILY_EMAIL_ENABLED=1        (0 이면 Cron·화면 메일발송 스킵)
#   화면 「메일발송」 버튼: /api/send-risk-email_stream (10시 Cron 과 동일)
#
# [DART 보강 Cron — vercel.json 에서 비활성화, 수동 호출만]
#   /api/cron/disclosure-refresh
#   DART_DISCLOSURE_REFRESH_MAX=60
#   DART_ENRICH_MANUAL_MAX=0
#   DART_ENRICH_SLEEP_SEC=0.15
#
# 배포 확인: https://your-app.vercel.app/api/health
#   supabase_ready: true, customer_row_count: 숫자 → 정상
# =============================================================================

# HTTPS (회사 프록시/SSL 검사로 Python만 인증 실패할 때)
# HTTP_USE_SYSTEM_CA=1
# HTTP_USE_SYSTEM_CA=0
# HTTP_SSL_VERIFY=0
# HTTP_SSL_VERIFY=C:\path\corp-root.pem

# Supabase (로컬 .env 예시)
# SUPABASE_URL=https://jiefcnqfagjvqaobdhyk.supabase.co
# SUPABASE_KEY=your_anon_or_publishable_key

# Flask 로컬
# FLASK_PORT=5058
# FLASK_HOST=127.0.0.1
# FLASK_DEBUG=1
