# 금융감독원 오픈다트 API 인증키 (40자). 이 파일을 복사해 .env 로 저장하세요.
# 예: copy env.example .env
DART_API_KEY=f5ead9ebbcaf4ae53593706ba606916e4dbd8f35

# HTTPS (회사 프록시/SSL 검사로 Python만 인증 실패할 때)
# HTTP_USE_SYSTEM_CA=1  — OS 신뢰 저장소 사용(기본, 브라우저와 동일)
# HTTP_USE_SYSTEM_CA=0  — truststore 비활성화(certifi 기본)
# HTTP_SSL_VERIFY=0       — TLS 검증 끄기(가능한 한 사용하지 말 것)
# HTTP_SSL_VERIFY=C:\path\corp-root.pem  — 사용자 지정 CA 번들

# 사업자번호 고정 목록: data/dart_bizno_input_list.txt
#   - 웹: 체크박스「dart_bizno_input_list.txt 사업자번호 목록으로만 분석」
#   - API: JSON 에 "source":"dart_bizno_input_list" 또는 "use_dart_bizno_list": true
#   - CLI: python demo_run.py --dart-bizno-list
#   - 마스터 리스트: python build_dart_registry.py → data/dart_biz_master_list.csv
#     (사업자번호, 업체명, 공시번호=DART고유번호, 종목코드). 기존 dart_company_registry.csv 도 읽기 호환.
#
# 런타임(웹/분석)에서 bizr_no 직접 조회가 안 될 때 공시대상 목록 스캔 상한 (기본 12000, 최대 200000)
# DART_RUNTIME_BIZ_SCAN_MAX=12000

# 웹/API 대량 분석 시 고객 건 사이 sleep(초). DART 일일 한도 완화에 도움 (예: 0.12 ~ 0.25)
# DART_ANALYZE_SLEEP_SEC=0
# 일괄 분석 병렬 워커 (기본 6, RSS·yfinance는 건마다 조회 유지)
# ANALYZE_BULK_WORKERS=6

# build_dart_registry.py — 일일 API 호출 상한(1단계 bizr_no + 2단계 스캔 합산 기준으로 2단계 상한 자동 축소)
# DART_BUILD_DAILY_CALL_CAP=40000
# 2단계 company.json 최대 호출(미설정 시 위 cap과 동일하게 취급)
# DART_BUILD_MAX_SCAN=40000
# cap 에서 1단계·corp 캐시 miss 등 여유로 뺄 호출 수
# DART_BUILD_API_MARGIN=300

# Flask 웹 서버 (기본 5058 — 5050 과 겹칠 때 변경)
# FLASK_PORT=5058
# FLASK_HOST=127.0.0.1
# FLASK_DEBUG=1
# FLASK_USE_RELOADER=0

# Open DART corpCode.zip 는 기본 7일 캐시. 목록 최신 분량 확인 시 재다운로드:
# DART_CORPCODE_IGNORE_CACHE=1
